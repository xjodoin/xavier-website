---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/tokens.css';
import '../styles/globals.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, absolute, htmlLang, ogLocale, type Alternates, type Locale, CONTACT_EMAIL } from '../i18n/config';
import { services, servicePath, ui } from '../i18n/content';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Canonical path of this page, e.g. "/fr/services/agents-ia/". */
  path: string;
  /** Equivalent pages in other languages (including this one). */
  alternates?: Alternates;
  type?: 'website' | 'article';
  ogImage?: string;
  /** Extra JSON-LD nodes for this page (WebPage, FAQPage, Service, BlogPosting...). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  published?: Date;
}

const {
  title,
  description,
  locale,
  path,
  alternates = { [locale]: path },
  type = 'website',
  ogImage = `/og-${locale}.jpg`,
  schema = [],
  noindex = false,
  published
} = Astro.props;

const locales = (current: Locale) =>
  (['en', 'fr'] as Locale[]).filter((l) => l !== current).map((l) => ogLocale[l]);
const canonical = absolute(path);
const analyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
const t = ui[locale];

const personId = `${SITE_URL}/#person`;
const businessId = `${SITE_URL}/#business`;

const city = (name: string, wiki: string) => ({ '@type': 'City', name, sameAs: wiki });

const graph = [
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    url: `${SITE_URL}/`,
    name: 'Xavier Jodoin',
    inLanguage: ['en-CA', 'fr-CA'],
    publisher: { '@id': businessId }
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Xavier Jodoin',
    url: `${SITE_URL}/`,
    image: absolute('/images/xavier-portrait-800w.webp'),
    jobTitle: locale === 'fr' ? 'Consultant et ingénieur en intelligence artificielle' : 'AI Consultant and Engineer',
    email: `mailto:${CONTACT_EMAIL}`,
    knowsLanguage: ['en', 'fr'],
    knowsAbout: [
      'Artificial intelligence',
      'AI agents',
      'Large language models',
      'Machine learning',
      'Computer vision',
      'Workflow automation',
      'Model Context Protocol',
      'Flutter',
      'Python',
      'TypeScript'
    ],
    address: { '@type': 'PostalAddress', addressLocality: 'Montréal', addressRegion: 'QC', addressCountry: 'CA' },
    sameAs: [
      'https://www.linkedin.com/in/xjodoin',
      'https://github.com/xjodoin',
      'https://huggingface.co/xjodoin'
    ]
  },
  {
    '@type': 'ProfessionalService',
    '@id': businessId,
    name: locale === 'fr' ? 'Xavier Jodoin — Consultation en IA' : 'Xavier Jodoin — AI Consulting',
    url: `${SITE_URL}${locale === 'fr' ? '/fr/' : '/'}`,
    image: absolute(`/og-${locale}.jpg`),
    logo: absolute('/icon-512.png'),
    email: CONTACT_EMAIL,
    description:
      locale === 'fr'
        ? "Consultation en intelligence artificielle, développement d'agents IA et de modèles sur mesure pour les PME de Montréal et du Québec."
        : 'AI consulting, custom AI agent development and custom model development for small and mid-sized businesses in Montréal and Québec.',
    founder: { '@id': personId },
    address: { '@type': 'PostalAddress', addressLocality: 'Montréal', addressRegion: 'QC', addressCountry: 'CA' },
    geo: { '@type': 'GeoCoordinates', latitude: 45.5019, longitude: -73.5674 },
    areaServed: [
      city('Montréal', 'https://en.wikipedia.org/wiki/Montreal'),
      city('Laval', 'https://en.wikipedia.org/wiki/Laval,_Quebec'),
      city('Longueuil', 'https://en.wikipedia.org/wiki/Longueuil'),
      city('Québec City', 'https://en.wikipedia.org/wiki/Quebec_City'),
      { '@type': 'AdministrativeArea', name: 'Québec', sameAs: 'https://en.wikipedia.org/wiki/Quebec' },
      { '@type': 'Country', name: 'Canada' }
    ],
    availableLanguage: ['English', 'French'],
    knowsAbout: ['AI agents', 'AI integration', 'Workflow automation', 'Machine learning', 'Computer vision', 'Generative AI'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: locale === 'fr' ? 'Services en intelligence artificielle' : 'AI services',
      itemListElement: services.map((s) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: s.name[locale],
          url: absolute(servicePath(s, locale))
        }
      }))
    }
  },
  ...schema
];

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

const themeScript = `(()=>{try{var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}})();`;
const analyticsSnippet = analyticsId
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${analyticsId}',{anonymize_ip:true});`
  : '';
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && Object.entries(alternates).map(([l, p]) => (
      <link rel="alternate" hreflang={htmlLang[l as Locale]} href={absolute(p!)} />
    ))}
    {!noindex && alternates.en && <link rel="alternate" hreflang="x-default" href={absolute(alternates.en)} />}

    <meta name="author" content="Xavier Jodoin" />
    <meta name="geo.region" content="CA-QC" />
    <meta name="geo.placename" content="Montréal" />
    <meta name="geo.position" content="45.5019;-73.5674" />
    <meta name="ICBM" content="45.5019, -73.5674" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Xavier Jodoin — Writing" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Xavier Jodoin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {locales(locale).map((l) => <meta property="og:locale:alternate" content={l} />)}
    {published && <meta property="article:published_time" content={published.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(ogImage)} />

    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f12" media="(prefers-color-scheme: dark)" />

    <script is:inline set:html={themeScript}></script>
    <script type="application/ld+json" set:html={jsonLd}></script>

    {analyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
        <script is:inline set:html={analyticsSnippet}></script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header locale={locale} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<script>
  // Theme toggle (the initial theme is applied inline in <head> to avoid a flash).
  const root = document.documentElement;
  const current = () =>
    root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const sync = () =>
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(current() === 'dark')));
  document.querySelectorAll('[data-theme-toggle]').forEach((button) =>
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    })
  );
  sync();
</script>
