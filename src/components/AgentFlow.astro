---
import Icon from './Icon.astro';

interface Props {
  steps: readonly { tag: string; title: string; body: string; human?: boolean }[];
  compact?: boolean;
}
const { steps, compact = false } = Astro.props;
---
<ol class:list={['flow', { 'flow--compact': compact }]}>
  {steps.map((s, i) => (
    <li class:list={['flow__step', { 'flow__step--human': s.human }]}>
      <span class="flow__tag">
        {s.human ? <Icon name="user" size={14} /> : <span class="flow__num">{String(i + 1).padStart(2, '0')}</span>}
        {s.tag}
      </span>
      <strong class="flow__title">{s.title}</strong>
      {!compact && <span class="flow__body">{s.body}</span>}
    </li>
  ))}
</ol>

<style>
  .flow {
    list-style: none;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    counter-reset: flow;
  }

  .flow__step {
    position: relative;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  /* Connector arrow between steps on wide screens */
  @media (min-width: 1000px) {
    .flow {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-6);
    }

    .flow__step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: calc(var(--space-6) * -1 + 4px);
      width: calc(var(--space-6) - 8px);
      height: 1px;
      background: var(--line-strong);
    }
  }

  .flow__step--human {
    border-color: var(--accent);
    background: var(--accent-soft);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .flow__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .flow__step--human .flow__tag {
    color: var(--accent);
    font-weight: 600;
  }

  .flow__num {
    color: var(--ink);
  }

  .flow__title {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .flow__body {
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.5;
  }

  .flow--compact {
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  }

  .flow--compact .flow__step {
    padding: var(--space-3) var(--space-4);
  }

  @media (min-width: 1000px) {
    .flow--compact {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-3);
    }

    .flow--compact .flow__step:not(:last-child)::after {
      right: calc(var(--space-3) * -1);
      width: var(--space-3);
    }
  }
</style>
