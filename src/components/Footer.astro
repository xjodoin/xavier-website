---
import Icon from './Icon.astro';
import { CONTACT_EMAIL, homePath, type Locale } from '../i18n/config';
import { services, servicePath, ui } from '../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
---
<footer class="site-footer" id="footer">
  <div class="container site-footer__grid">
    <div class="site-footer__about">
      <a href={homePath[locale]} class="site-footer__brand">Xavier Jodoin</a>
      <p>{t.footerTagline}</p>
      <p class="site-footer__area">
        <Icon name="pin" size={16} />
        <span>{t.footerArea}</span>
      </p>
    </div>
    <nav aria-label={t.footerServices}>
      <h2 class="site-footer__title">{t.footerServices}</h2>
      <ul>
        {services.map((s) => (
          <li><a href={servicePath(s, locale)}>{s.name[locale]}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label={t.footerElsewhere}>
      <h2 class="site-footer__title">{t.footerElsewhere}</h2>
      <ul>
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        <li><a href="https://www.linkedin.com/in/xjodoin" rel="me noopener" target="_blank">LinkedIn</a></li>
        <li><a href="https://github.com/xjodoin" rel="me noopener" target="_blank">GitHub</a></li>
        <li><a href="https://huggingface.co/xjodoin" rel="me noopener" target="_blank">Hugging Face</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>
  <div class="container site-footer__bottom">
    <p>© {year} Xavier Jodoin. {t.rights}</p>
    <p>
      <a href="/" hreflang="en-CA" lang="en">English</a>
      <span aria-hidden="true"> · </span>
      <a href="/fr/" hreflang="fr-CA" lang="fr">Français</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-16) var(--space-8);
    font-size: 0.95rem;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-10);
    grid-template-columns: 1fr;
  }

  @media (min-width: 800px) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .site-footer__brand {
    display: inline-block;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: var(--space-3);
  }

  .site-footer__about p {
    color: var(--ink-2);
    max-width: 52ch;
  }

  .site-footer__area {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--muted) !important;
    font-size: 0.9rem;
  }

  .site-footer__area :global(svg) {
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .site-footer__title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .site-footer ul {
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .site-footer nav a {
    color: var(--ink);
    text-decoration: none;
  }

  .site-footer nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }

  .site-footer__bottom a {
    color: var(--muted);
  }
</style>
