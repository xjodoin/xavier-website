---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';
import { absolute } from '../../i18n/config';
import { home } from '../../i18n/content';
import { faqPage, webPage } from '../../i18n/schema';

const locale = 'fr';
const c = home[locale];
const path = '/fr/';
---
<BaseLayout
  title={c.seo.title}
  description={c.seo.description}
  locale={locale}
  path={path}
  alternates={{ en: '/', fr: '/fr/' }}
  schema={[...webPage({ path, title: c.seo.title, description: c.seo.description, locale }), faqPage(c.faq.items, absolute(path))]}
>
  <HomePage locale={locale} />
</BaseLayout>
